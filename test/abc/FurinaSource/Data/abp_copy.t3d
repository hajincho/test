   ShowPinForProperties(31)=(PropertyName="PlanarLimits",PropertyFriendlyName="Planar Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:PlanarLimits", "List of available planar limits for this node"),CategoryName="PlanarLimit")
