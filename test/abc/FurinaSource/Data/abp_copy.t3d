   ShowPinForProperties(16)=(PropertyName="GravityScale",PropertyFriendlyName="Gravity Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:GravityScale", "Scale for gravity, higher values increase forces due to gravity"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bHasOverridePin=True)
   ShowPinForProperties(17)=(PropertyName="GravityOverride",PropertyFriendlyName="Gravity Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:GravityOverride", "Gravity Override Value"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bHasOverridePin=True)
   ShowPinForProperties(18)=(PropertyName="LinearSpringConstant",PropertyFriendlyName="Linear Spring Constant",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:LinearSpringConstant", "Spring constant to use when calculating linear springs, higher values mean a stronger spring.\nYou need to enable the Linear Spring checkbox for this to have an effect."),CategoryName="PhysicsParameters",bCanToggleVisibility=True)
   ShowPinForProperties(19)=(PropertyName="AngularSpringConstant",PropertyFriendlyName="Angular Spring Constant",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:AngularSpringConstant", "Spring constant to use when calculating angular springs, higher values mean a stronger spring.\nYou need to enable the Angular Spring checkbox for this to have an effect.\nNote: Make sure to also set the Angular Target Axis and Angular Target in the Constraint Setup for this to have an effect."),CategoryName="PhysicsParameters",bCanToggleVisibility=True)
   ShowPinForProperties(20)=(PropertyName="WorldSpaceMinimumScale",PropertyFriendlyName="World Space Minimum Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:WorldSpaceMinimumScale", "For world-space simulations, if the magnitude of the component\'s 3D scale is less than WorldSpaceMinimumScale, do not update the node."),CategoryName="Settings")
   ShowPinForProperties(21)=(PropertyName="WindScale",PropertyFriendlyName="Wind Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:WindScale", "Scale to apply to calculated wind velocities in the solver"),CategoryName="Wind")
   ShowPinForProperties(22)=(PropertyName="ComponentLinearAccScale",PropertyFriendlyName="Component Linear Acc Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ComponentLinearAccScale", "When using non-world-space sim, this controls how much of the components world-space acceleration is passed on to the local-space simulation."),CategoryName="Settings",bCanToggleVisibility=True)
   ShowPinForProperties(23)=(PropertyName="ComponentLinearVelScale",PropertyFriendlyName="Component Linear Vel Scale",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ComponentLinearVelScale", "When using non-world-space sim, this applies a \'drag\' to the bodies in the local space simulation, based on the components world-space velocity."),CategoryName="Settings",bCanToggleVisibility=True)
   ShowPinForProperties(24)=(PropertyName="ComponentAppliedLinearAccClamp",PropertyFriendlyName="Component Applied Linear Acc Clamp",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ComponentAppliedLinearAccClamp", "When using non-world-space sim, this is an overall clamp on acceleration derived from ComponentLinearAccScale and ComponentLinearVelScale, to ensure it is not too large."),CategoryName="Settings")
   ShowPinForProperties(25)=(PropertyName="SimSpaceSettings",PropertyFriendlyName="Sim Space Settings",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:SimSpaceSettings", "Settings for the system which passes motion of the simulation\'s space\ninto the simulation. This allows the simulation to pass a\nfraction of the world space motion onto the bodies which allows Bone-Space\nand Component-Space simulations to react to world-space movement in a\ncontrollable way.\nThis system is a superset of the functionality provided by ComponentLinearAccScale,\nComponentLinearVelScale, and ComponentAppliedLinearAccClamp. In general\nyou should not have both systems enabled."),CategoryName="Settings",bCanToggleVisibility=True)
   ShowPinForProperties(26)=(PropertyName="AngularBiasOverride",PropertyFriendlyName="Angular Bias Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:AngularBiasOverride", "Overridden angular bias value\nAngular bias is essentially a twist reduction for chain forces and defaults to a value to keep chains stability\nin check. When using single-body systems sometimes angular forces will look like they are \"catching-up\" with\nthe mesh, if that\'s the case override this and push it towards 1.0f until it settles correctly"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(27)=(PropertyName="NumSolverIterationsPreUpdate",PropertyFriendlyName="Num Solver Iterations Pre Update",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:NumSolverIterationsPreUpdate", "Number of update passes on the linear and angular limits before we solve the position of the bodies recommended to be four times the value of NumSolverIterationsPostUpdate"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(28)=(PropertyName="NumSolverIterationsPostUpdate",PropertyFriendlyName="Num Solver Iterations Post Update",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:NumSolverIterationsPostUpdate", "Number of update passes on the linear and angular limits after we solve the position of the bodies, recommended to be around a quarter of NumSolverIterationsPreUpdate"),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(29)=(PropertyName="SphericalLimits",PropertyFriendlyName="Spherical Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:SphericalLimits", "List of available spherical limits for this node"),CategoryName="SphericalLimit")
   ShowPinForProperties(30)=(PropertyName="ExternalForce",PropertyFriendlyName="External Force",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:ExternalForce", "An external force to apply to all bodies in the simulation when ticked, specified in world space"),CategoryName="Forces",bShowPin=True,bCanToggleVisibility=True)
   ShowPinForProperties(31)=(PropertyName="PlanarLimits",PropertyFriendlyName="Planar Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:PlanarLimits", "List of available planar limits for this node"),CategoryName="PlanarLimit")
   ShowPinForProperties(32)=(PropertyName="bUseSphericalLimits",PropertyFriendlyName="Use Spherical Limits",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bUseSphericalLimits", "Whether to evaluate spherical limits"),CategoryName="SphericalLimit")
   ShowPinForProperties(33)=(PropertyName="bUsePlanarLimit",PropertyFriendlyName="Use Planar Limit",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bUsePlanarLimit", "Whether to evaluate planar limits"),CategoryName="PlanarLimit")
   ShowPinForProperties(34)=(PropertyName="bDoUpdate",PropertyFriendlyName="Do Update",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bDoUpdate", "If true we will perform physics update, otherwise skip - allows visualization of the initial state of the bodies"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(35)=(PropertyName="bDoEval",PropertyFriendlyName="Do Eval",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bDoEval", "If true we will perform bone transform evaluation, otherwise skip - allows visualization of the initial anim state compared to the physics sim"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(36)=(PropertyName="bOverrideLinearDamping",PropertyFriendlyName="Override Linear Damping",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bOverrideLinearDamping", "If true, the override value will be used for linear damping"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(37)=(PropertyName="bOverrideAngularBias",PropertyFriendlyName="Override Angular Bias",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bOverrideAngularBias", "If true, the override value will be used for the angular bias for bodies in this node.\nAngular bias is essentially a twist reduction for chain forces and defaults to a value to keep chains stability\nin check. When using single-body systems sometimes angular forces will look like they are \"catching-up\" with\nthe mesh, if that\'s the case override this and push it towards 1.0f until it settles correctly"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(38)=(PropertyName="bOverrideAngularDamping",PropertyFriendlyName="Override Angular Damping",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bOverrideAngularDamping", "If true, the override value will be used for angular damping"),CategoryName="PhysicsParameters",bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(39)=(PropertyName="bEnableWind",PropertyFriendlyName="Enable Wind",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bEnableWind", "Whether or not wind is enabled for the bodies in this simulation"),CategoryName="Wind")
   ShowPinForProperties(40)=(PropertyName="bUseGravityOverride",PropertyFriendlyName="Use Gravity Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bUseGravityOverride", "Use gravity override value vs gravity scale"),CategoryName="PhysicsParameters")
   ShowPinForProperties(41)=(PropertyName="bGravityOverrideInSimSpace",PropertyFriendlyName="Gravity Override In Sim Space",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bGravityOverrideInSimSpace", "If true the gravity override value is defined in simulation space, by default it is in world space"),CategoryName="PhysicsParameters",bHasOverridePin=True)
   ShowPinForProperties(42)=(PropertyName="bLinearSpring",PropertyFriendlyName="Linear Spring",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bLinearSpring", "If true the body will attempt to spring back to its initial position"),CategoryName="PhysicsParameters")
   ShowPinForProperties(43)=(PropertyName="bAngularSpring",PropertyFriendlyName="Angular Spring",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bAngularSpring", "If true the body will attempt to align itself with the specified angular target"),CategoryName="PhysicsParameters")
   ShowPinForProperties(44)=(PropertyName="bChain",PropertyFriendlyName="Chain",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:bChain", "Set to true to use the solver to simulate a connected chain"),CategoryName="Setup")
   ShowPinForProperties(45)=(PropertyName="RetargetingSettings",PropertyFriendlyName="Retargeting Settings",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:RetargetingSettings", "The settings for rotation retargeting"),CategoryName="Retargeting")
