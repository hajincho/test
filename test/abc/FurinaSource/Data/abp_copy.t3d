   ShowPinForProperties(11)=(PropertyName="AngularDampingOverride",PropertyFriendlyName="Angular Damping Override",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:AngularDampingOverride", "Overridden angular damping value. The default is 0.7. Values below 0.7 won\'t have an effect."),CategoryName="PhysicsParameters",bCanToggleVisibility=True,bIsMarkedForAdvancedDisplay=True)
   ShowPinForProperties(12)=(PropertyName="RelativeSpaceBone",PropertyFriendlyName="Relative Space Bone",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_AnimDynamics:RelativeSpaceBone", "When in BoneRelative sim space, the simulation will use this bone as the origin"),CategoryName="Setup")
