   CustomProperties Pin (PinId=FDDACF8446E94AD94835CC8F8FCEC668,PinName="Started",PinToolTip="트리거 평가를 시작한 이벤트가 발생했습니다. 참고: Triggered가 이 프레임에서도 발생할 수 있지만 항상 이 이벤트가 먼저 발동됩니다.",Direction="EGPD_Output",PinType.PinCategory="exec",PinType.PinSubCategory="",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,LinkedTo=(K2Node_CallFunction_26 93CEA8A648FE627E9C2424B9BEA6F74F,),PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
   CustomProperties Pin (PinId=4565769A41E7DA5131BB93BDD355EB7F,PinName="Ongoing",PinToolTip="트리거링이 여전히 처리 중입니다. 예를 들어 \'누르고 있기\' 트리거가 있는 액션은\n사용자가 키를 누르고 있지만 시간 한계치가 아직 충족되지 않은 동안 \'Ongoing\'이 됩니다.",Direction="EGPD_Output",PinType.PinCategory="exec",PinType.PinSubCategory="",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
   CustomProperties Pin (PinId=B1D4D4A44D8CEF6945E663B2737A3441,PinName="Canceled",PinToolTip="트리거링이 취소되었습니다. 예를 들어 사용자가 \'누르고 있기\' 시간 한계치 이전에 키에서 손을 뗐습니다.\n액션이 평가되기 시작했지만 완료되지 않았습니다.",Direction="EGPD_Output",PinType.PinCategory="exec",PinType.PinSubCategory="",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
   CustomProperties Pin (PinId=7B4EC8F64A62683C091D4D8207AF7FF5,PinName="Completed",PinToolTip="트리거 상태가 이 프레임에서 Triggered에서 None으로 전환되었습니다. 즉, 트리거링이 완료되었습니다.\n참고: 이 이벤트를 사용하면 Started/Completed 이벤트를 위한 트리거 세트가 하나로 제한됩니다. 각각 자체 트리거 규칙이 있는 두 개의 액션을 선호할 수도 있습니다.\n동일한 프레임에 Ongoing으로 보고되는 트리거가 있는 경우, Completed는 발동되지 않지만 두 트리거 모두 발동되어야 합니다. 예를 들어 길게 누르기(= Ongoing) + 눌림(= None) 콤보의 두 가지 틱으로는 Ongoing 이벤트만 발생됩니다.",Direction="EGPD_Output",PinType.PinCategory="exec",PinType.PinSubCategory="",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
   CustomProperties Pin (PinId=F8739039443AC8BFEC5FD4A43B1D7C1E,PinName="ActionValue",Direction="EGPD_Output",PinType.PinCategory="bool",PinType.PinSubCategory="",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="false",AutogeneratedDefaultValue="false",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=False,bOrphanedPin=False,)
